{
  "name": "@notikit/web-sdk",
  "version": "0.1.0",
  "description": "Notikit Web SDK — browser push via FCM (Firebase Cloud Messaging)",
  "license": "Apache-2.0",
  "homepage": "https://notikit.mint-soft.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintsoft-opensource/notikit-js.git",
    "directory": "packages/sdk-web"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@notikit/core": "workspace:*"
  },
  "devDependencies": {
    "firebase": "^12.19.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "firebase": ">=10"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  }
}
