{
  "name": "@mint-soft/notikit-react-native",
  "version": "0.2.0",
  "description": "Notikit React Native SDK — device registration + identity over @mint-soft/notikit-core",
  "license": "Apache-2.0",
  "homepage": "https://notikit.mint-soft.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintsoft-opensource/notikit-js.git",
    "directory": "packages/sdk-react-native"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@mint-soft/notikit-core": "workspace:*"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
